---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	width?: number;
	height?: number;
	tarotRomanNumber: string;
	tarotName: string;
}

const { image, alt, width = 300, height = 300, tarotRomanNumber, tarotName } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-2 rounded-lg bg-[#d7bea6] p-2">
	<div class="relative overflow-hidden rounded-lg border border-black">
		<p
			class="absolute top-2 left-1/2 -translate-x-1/2 rounded-xl border border-black bg-[#d7bea6] px-2 text-center text-xs font-semibold text-black"
		>
			{tarotRomanNumber}
		</p>
		<Image src={image} alt={alt} width={width} height={height} />
	</div>
	<p class="font-semibold text-black">{tarotName}</p>
</div>
