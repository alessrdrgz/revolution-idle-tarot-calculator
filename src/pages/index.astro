---
import CooldownCalculator from '@/components/pages/CooldownCalculator.astro';
import DeathCalculator from '@/components/pages/DeathCalculator.astro';
import TowerCalculator from '@/components/pages/TowerCalculator.astro';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Tile } from '@/components/ui/tile';
import Layout from '@/layouts/Layout.astro';
---

<Layout>
	<Tabs defaultValue="tower-tab">
		<TabsList>
			<TabsTrigger value="tower-tab">Tower</TabsTrigger>
			<TabsTrigger value="cd-tab">Cooldown</TabsTrigger>
			<TabsTrigger value="death-tab">Death</TabsTrigger>
		</TabsList>
		<Tile variant="floating">
			<article class="w-full">
				<TabsContent value="tower-tab">
					<TowerCalculator />
				</TabsContent>
				<TabsContent value="cd-tab">
					<CooldownCalculator />
				</TabsContent>
				<TabsContent value="death-tab">
					<DeathCalculator />
				</TabsContent>
			</article>
		</Tile>
	</Tabs>
</Layout>
